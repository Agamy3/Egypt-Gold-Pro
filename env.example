# Supabase Configuration
# Copy these variables to your .env.local file

# Supabase Project URL (Public - safe for client-side)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url

# Supabase Anon/Public Key (Public - safe for client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Supabase Service Role Key (Server-only - DO NOT expose to client)
# Get this from: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Site URL for metadata (used in Open Graph, Twitter cards, etc.)
# For production: https://egyptgoldpro.com
# For local dev: http://localhost:3000
NEXT_PUBLIC_SITE_URL=https://egyptgoldpro.com

# Existing Environment Variables
# GOLDAPI_KEY=your_goldapi_key
# DATABASE_PATH=./db/egyptgold.db
# CRON_SECRET=your_cron_secret
# EGYPT_TRUSTED_ONLY_MODE=false



