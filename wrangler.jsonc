{
  "$schema": "node_modules/wrangler/config-schema.json",
  // OpenNext: deploy/preview need `.open-next/.build/open-next.config.edge.mjs` from `opennextjs-cloudflare build`
  // (or `npm run cf:build`). Plain `next build` / `npm run build` is not sufficient for Workers.
  // Use `npm run deploy` or `npm run cf:build` then `npm run cf:deploy` — do not run bare `wrangler deploy` without a prior OpenNext build.
  // Web Push: set VAPID_PUBLIC_KEY + VAPID_PRIVATE_KEY (+ VAPID_SUBJECT) in vars/secrets. If NEXT_PUBLIC_VAPID_PUBLIC_KEY
  // is missing from the client bundle (common when it was not set at build time), the app uses GET /api/push/vapid-public-key.
  // Crons: `main` wraps OpenNext with `scheduled` (Vercel crons do not run on CF). Keep triggers in sync with cloudflare-cron-entry.mjs.
  "main": "cloudflare-cron-entry.mjs",
  "triggers": {
    "crons": [
      "* * * * *",
      "*/5 * * * *",
      "*/10 * * * *",
      "*/15 * * * *",
      "0 */6 * * *"
    ]
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1
    }
  },
  "name": "egyptgoldpro",
  "compatibility_date": "2025-03-01",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    { "binding": "CRON_JOBS", "service": "egyptgoldpro-jobs" },
    {
      "binding": "WORKER_SELF_REFERENCE",
      "service": "egyptgoldpro"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "vars": {}
}
